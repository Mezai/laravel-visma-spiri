{
    "name": "mezai/laravel-visma-spiri",
    "description": "laravel integration with Visma Spiri api",
    "license": "MIT",
    "authors": [
        {
            "name": "Johan Tedenmark",
            "email": "johan.tedenmark@hotmail.se"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/socialite": "^5.30",
        "spatie/laravel-package-tools": "^1.93",
        "guzzlehttp/guzzle": "^7.15",
        "illuminate/contracts": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^5.1",
        "orchestra/testbench": "^11.2"
    },
    "suggest": {
        "illuminate/contracts": "Required to use the Laravel integration (^12.0|^13.0).",
        "illuminate/support": "Required to use the Laravel integration (^12.0|^13.0)."
    },
    "autoload": {
        "psr-4": {
            "Mezai\\Visma\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mezai\\Visma\\Test\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mezai\\Visma\\Providers\\VismaServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "./vendor/bin/pest"
    }
}
